{
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @tubmind/web dev",
    "dev:mobile": "pnpm --filter @tubmind/native dev",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=18"
  },
  "name": "tubmind-monorepo",
  "packageManager": "pnpm@10.29.1"
}
